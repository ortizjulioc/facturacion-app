# --- Base de datos (Postgres) ---
# Usuario sin superusuario para la app; las migraciones usan DATABASE_URL_MIGRATE si existe.
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/facturacion"

# --- API ---
API_PORT=3001
# Origen del back-office, para CORS y cookies de Better Auth
WEB_ORIGIN="http://localhost:3000"
API_PUBLIC_URL="http://localhost:3001"
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- Firma de e-CF ---
# Llave que cifra el certificado digital (.p12) de cada empresa en la base de datos: 32 bytes en base64 (o 64 hex).
# Obligatoria en producción. Si la pierdes, hay que volver a subir el certificado. Genera una con: openssl rand -base64 32
# CERT_ENCRYPTION_KEY=""

# Trabajador que envía los e-CF firmados a la DGII y consulta sus resultados (por omisión true; ponlo en false en réplicas).
# FISCAL_WORKER="true"

# --- Servicios públicos de recepción (/fe) ---
# "true" solo si la API va detrás de un proxy de confianza (Traefik/Dokploy): toma la dirección del cliente de X-Forwarded-For.
# Con "false" (por omisión) ese encabezado se ignora y el límite de uso cuenta la dirección de la conexión.
# TRUST_PROXY="false"
# Pedidos por minuto: por dirección, por empresa destinataria, y por dirección para la autenticación.
# FE_RATE_LIMIT_PER_MINUTE=60
# FE_RATE_LIMIT_PER_RNC_PER_MINUTE=300
# FE_AUTH_RATE_LIMIT_PER_MINUTE=20

# Versiones de la caja para la auto-actualización: carpeta con el instalador, su .blockmap y latest.yml (apps/pos/dist).
# La API las publica en /updates/caja. Ver docs/CAJA-INSTALADOR.md.
# POS_RELEASES_DIR="./releases/caja"
