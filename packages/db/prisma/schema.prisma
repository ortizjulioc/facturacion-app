// Schema de la NUBE (Postgres). La caja tiene su propio schema SQLite en packages/db-local.
//
// Multiempresa: cada "Organization" (Better Auth) es una empresa/tenant.
// Toda tabla de negocio lleva organizationId y tiene RLS (ver migración rls_*).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Better Auth (usuarios, sesiones, organizaciones) ─────────────

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id             String          @id
  name           String
  slug           String          @unique
  logo           String?
  createdAt      DateTime        @default(now())
  metadata       String?
  members        Member[]
  invitations    Invitation[]
  branches       Branch[]
  terminals      Terminal[]
  categories     Category[]
  products       Product[]
  customers      Customer[]
  companyProfile CompanyProfile?
  sequences      Sequence[]
  documents      Document[]
  auditLogs      AuditLog[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  suppliers      Supplier[]
  purchases      Purchase[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}

// ───────────── Negocio (con RLS por organizationId) ─────────────

/// Sucursal / local de la empresa. Las cajas (terminales) cuelgan de aquí en la Fase 1.
model Branch {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String
  name           String
  code           String
  address        String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terminals      Terminal[]
  documents      Document[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  purchases      Purchase[]

  @@unique([organizationId, code])
  @@map("branch")
}

/// Caja / terminal de venta. En la Fase 3 recibe aquí sus bloques de secuencias e-NCF.
model Terminal {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String
  branchId       String       @db.Uuid
  name           String
  code           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: NoAction)
  sequences      Sequence[]
  documents      Document[]

  @@unique([organizationId, code])
  @@index([branchId])
  @@map("terminal")
}

/// Mismo código que `TaxCode` de @facturacion/core (la API verifica que coincidan).
enum TaxCode {
  ITBIS18
  ITBIS16
  ITBIS0
  EXENTO
}

enum DocumentType {
  RNC
  CEDULA
  PASAPORTE
}

model Category {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String
  name           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name])
  @@map("category")
}

/// Producto o servicio vendible. Dinero en centavos (BigInt); impuesto según TaxCode.
model Product {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String
  categoryId       String?         @db.Uuid
  sku              String?
  barcode          String?
  name             String
  description      String?
  /// Precio unitario en centavos.
  price            BigInt
  /// true: `price` ya incluye el impuesto (precio al consumidor).
  priceIncludesTax Boolean         @default(true)
  tax              TaxCode         @default(ITBIS18)
  /// Unidad de medida mostrada: UND, KG, LB, HORA…
  unit             String          @default("UND")
  /// true: se vende con decimales (peso, volumen).
  allowsDecimals   Boolean         @default(false)
  /// true: al emitir se descuenta de las existencias de la sucursal.
  trackInventory   Boolean         @default(false)
  /// Existencia mínima (milésimas) por sucursal; por debajo se avisa de stock bajo.
  minStock         BigInt          @default(0)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  documentLines    DocumentLine[]
  /// Último costo unitario neto (sin impuesto) de compra, en centavos.
  lastCost         BigInt?
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  purchaseLines    PurchaseLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, name])
  @@index([categoryId])
  @@map("product")
}

model Customer {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String
  name           String
  documentType   DocumentType?
  /// Solo dígitos (RNC 9, cédula 11) o texto libre para pasaporte.
  documentNumber String?
  email          String?
  phone          String?
  address        String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]

  @@unique([organizationId, documentNumber])
  @@index([organizationId, name])
  @@map("customer")
}

/// Tipos de e-CF que se emiten hoy. Para agregar otros (E41, E43…) basta ampliar el enum.
enum EcfType {
  E31
  E32
  E33
  E34
  /// Comprobante de compras (lo emite la empresa a un proveedor informal).
  E41
  /// Gastos menores (lo emite la empresa).
  E43
}

enum DocumentStatus {
  /// Editable. Aún sin e-NCF.
  DRAFT
  /// Tiene e-NCF asignado y ya no se puede modificar.
  ISSUED
  SIGNED
  SENT
  ACCEPTED
  ACCEPTED_CONDITIONAL
  REJECTED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  CARD
  CREDIT
  OTHER
}

/// Ambiente de la DGII: TesteCF (pruebas), CerteCF (certificación) o eCF (producción).
enum EcfEnvironment {
  TEST
  CERT
  PROD
}

/// Datos fiscales del emisor (uno por empresa).
model CompanyProfile {
  id                 String         @id @default(uuid(7)) @db.Uuid
  organizationId     String         @unique
  rnc                String
  legalName          String
  tradeName          String?
  address            String
  province           String?
  municipality       String?
  economicActivity   String?
  email              String?
  phone              String?
  environment        EcfEnvironment @default(TEST)
  /// false: no se puede emitir un comprobante si falta existencia de un producto con inventario.
  allowNegativeStock Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("company_profile")
}

/// Rango de e-NCF autorizado por la DGII. `nextNumber` avanza de forma atómica al emitir.
model Sequence {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String
  ecfType        EcfType
  fromNumber     BigInt
  toNumber       BigInt
  /// Próximo número a asignar (from <= next <= to + 1).
  nextNumber     BigInt
  expiresAt      DateTime     @db.Date
  /// null = sirve a toda la empresa; con valor, solo a esa caja.
  terminalId     String?      @db.Uuid
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terminal       Terminal?    @relation(fields: [terminalId], references: [id], onDelete: NoAction)

  @@unique([organizationId, ecfType, fromNumber])
  @@index([organizationId, ecfType, active])
  @@map("sequence")
}

/// Comprobante. Editable solo en DRAFT; después una función de BD impide cambiar importes o líneas.
model Document {
  id                   String          @id @default(uuid(7)) @db.Uuid
  organizationId       String
  type                 EcfType
  status               DocumentStatus  @default(DRAFT)
  /// Se asigna al emitir.
  encf                 String?
  branchId             String          @db.Uuid
  terminalId           String?         @db.Uuid
  customerId           String?         @db.Uuid
  /// Copia del comprador al emitir (el cliente puede cambiar después).
  buyerName            String?
  buyerDocType         DocumentType?
  buyerDocNumber       String?
  currency             String          @default("DOP")
  exchangeRate         Decimal         @default(1) @db.Decimal(14, 4)
  propinaLegal         Boolean         @default(false)
  notes                String?
  /// Solo notas de crédito/débito.
  referencedDocumentId String?         @db.Uuid
  referencedEncf       String?
  modificationCode     Int?
  // Totales en centavos, calculados SIEMPRE en el servidor con @facturacion/core.
  totalDiscount        BigInt          @default(0)
  subtotal             BigInt          @default(0)
  base18               BigInt          @default(0)
  tax18                BigInt          @default(0)
  base16               BigInt          @default(0)
  tax16                BigInt          @default(0)
  base0                BigInt          @default(0)
  baseExempt           BigInt          @default(0)
  totalTax             BigInt          @default(0)
  propinaAmount        BigInt          @default(0)
  total                BigInt          @default(0)
  issuedAt             DateTime?
  createdById          String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch               Branch          @relation(fields: [branchId], references: [id], onDelete: NoAction)
  terminal             Terminal?       @relation(fields: [terminalId], references: [id], onDelete: NoAction)
  customer             Customer?       @relation(fields: [customerId], references: [id], onDelete: NoAction)
  referencedDocument   Document?       @relation("Modifies", fields: [referencedDocumentId], references: [id], onDelete: NoAction)
  modifiedBy           Document[]      @relation("Modifies")
  lines                DocumentLine[]
  payments             Payment[]
  stockMovements       StockMovement[]

  @@unique([organizationId, encf])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([customerId])
  @@index([branchId])
  @@index([referencedDocumentId])
  @@map("document")
}

/// Línea de un comprobante: copia de los datos del producto al momento de la venta.
model DocumentLine {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String
  documentId       String   @db.Uuid
  lineNumber       Int
  productId        String?  @db.Uuid
  name             String
  description      String?
  unit             String   @default("UND")
  /// Cantidad en milésimas (1000 = 1.000).
  quantity         BigInt
  unitPrice        BigInt
  priceIncludesTax Boolean
  tax              TaxCode
  /// "PERCENT" (valor en puntos básicos) o "AMOUNT" (valor en centavos).
  discountType     String?
  discountValue    BigInt?
  gross            BigInt
  discount         BigInt
  base             BigInt
  taxAmount        BigInt
  total            BigInt
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product          Product? @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@unique([documentId, lineNumber])
  @@index([productId])
  @@map("document_line")
}

model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String
  documentId     String        @db.Uuid
  method         PaymentMethod
  amount         BigInt
  reference      String?
  createdAt      DateTime      @default(now())
  document       Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("payment")
}

enum PurchaseKind {
  /// Factura (o e-CF) que emitió el proveedor y que la empresa registra.
  SUPPLIER_INVOICE
  /// Comprobante de compras que emite la empresa (proveedor informal).
  E41
  /// Gasto menor que emite la empresa.
  E43
}

enum PurchaseStatus {
  DRAFT
  /// Registrada: ya no se puede modificar ni borrar.
  POSTED
}

model Supplier {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String
  name           String
  documentType   DocumentType?
  /// Solo dígitos (RNC 9, cédula 11) o texto libre para pasaporte.
  documentNumber String?
  email          String?
  phone          String?
  address        String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases      Purchase[]

  @@unique([organizationId, documentNumber])
  @@index([organizationId, name])
  @@map("supplier")
}

/// Compra o gasto. Se edita solo en DRAFT; al registrarla (POSTED) queda congelada.
model Purchase {
  id                String          @id @default(uuid(7)) @db.Uuid
  organizationId    String
  kind              PurchaseKind
  status            PurchaseStatus  @default(DRAFT)
  branchId          String          @db.Uuid
  supplierId        String?         @db.Uuid
  /// Copia del proveedor al registrar.
  supplierName      String?
  supplierDocType   DocumentType?
  supplierDocNumber String?
  /// NCF del proveedor (factura de proveedor) o e-NCF que emite la empresa (E41/E43).
  ncf               String?
  /// Fecha del comprobante (la que va en el formato 606).
  invoiceDate       DateTime        @db.Date
  currency          String          @default("DOP")
  exchangeRate      Decimal         @default(1) @db.Decimal(14, 4)
  /// Tipo de bienes y servicios del 606 (1–11).
  expenseType       Int             @default(9)
  paymentMethod     PaymentMethod   @default(CASH)
  notes             String?
  // Totales en centavos, calculados SIEMPRE en el servidor con @facturacion/core.
  totalDiscount     BigInt          @default(0)
  subtotal          BigInt          @default(0)
  base18            BigInt          @default(0)
  tax18             BigInt          @default(0)
  base16            BigInt          @default(0)
  tax16             BigInt          @default(0)
  base0             BigInt          @default(0)
  baseExempt        BigInt          @default(0)
  totalTax          BigInt          @default(0)
  total             BigInt          @default(0)
  itbisWithheld     BigInt          @default(0)
  isrWithheld       BigInt          @default(0)
  postedAt          DateTime?
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch            Branch          @relation(fields: [branchId], references: [id], onDelete: NoAction)
  supplier          Supplier?       @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  lines             PurchaseLine[]
  stockMovements    StockMovement[]

  @@unique([organizationId, supplierId, ncf])
  @@index([organizationId, status])
  @@index([organizationId, invoiceDate])
  @@index([supplierId])
  @@index([branchId])
  @@map("purchase")
}

model PurchaseLine {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String
  purchaseId       String   @db.Uuid
  lineNumber       Int
  productId        String?  @db.Uuid
  name             String
  unit             String   @default("UND")
  /// Cantidad en milésimas (1000 = 1.000).
  quantity         BigInt
  /// Costo unitario tal como se digitó (con o sin impuesto según `priceIncludesTax`).
  unitCost         BigInt
  priceIncludesTax Boolean
  tax              TaxCode
  /// "PERCENT" (puntos básicos) o "AMOUNT" (centavos).
  discountType     String?
  discountValue    BigInt?
  gross            BigInt
  discount         BigInt
  base             BigInt
  taxAmount        BigInt
  total            BigInt
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product          Product? @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@unique([purchaseId, lineNumber])
  @@index([productId])
  @@map("purchase_line")
}

enum StockMovementType {
  /// Entrada de mercancía (compra, producción…).
  RECEIPT
  /// Salida por una venta emitida.
  SALE
  /// Reingreso por anulación de una venta (nota de crédito código 1).
  RETURN
  /// Corrección manual tras un conteo o por merma.
  ADJUSTMENT
}

/// Existencia actual de un producto en una sucursal. Se actualiza SIEMPRE junto con su movimiento.
model StockLevel {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String
  productId      String       @db.Uuid
  branchId       String       @db.Uuid
  /// Cantidad en milésimas (1000 = 1.000). Puede ser negativa si la empresa lo permite.
  quantity       BigInt       @default(0)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: NoAction)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: NoAction)

  @@unique([productId, branchId])
  @@index([organizationId, branchId])
  @@map("stock_level")
}

/// Libro de movimientos de inventario: solo se inserta (la BD impide modificar o borrar filas).
model StockMovement {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String
  productId      String            @db.Uuid
  branchId       String            @db.Uuid
  type           StockMovementType
  /// Con signo, en milésimas: entradas > 0, salidas < 0.
  quantity       BigInt
  /// Existencia resultante después de este movimiento.
  balanceAfter   BigInt
  /// Costo unitario en centavos (entradas).
  unitCost       BigInt?
  documentId     String?           @db.Uuid
  /// Compra que originó la entrada (si la hay).
  purchaseId     String?           @db.Uuid
  reason         String?
  createdById    String
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: NoAction)
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: NoAction)
  document       Document?         @relation(fields: [documentId], references: [id], onDelete: NoAction)
  purchase       Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: NoAction)

  @@index([organizationId, productId, createdAt])
  @@index([purchaseId])
  @@index([organizationId, createdAt])
  @@index([documentId])
  @@map("stock_movement")
}

/// Bitácora inmutable (solo se inserta; la migración revoca UPDATE/DELETE al rol de la app).
model AuditLog {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String
  actorUserId    String?
  action         String
  entity         String
  entityId       String?
  data           Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}
