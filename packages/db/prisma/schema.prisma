// Schema de la NUBE (Postgres). La caja tiene su propio schema SQLite en packages/db-local.
//
// Multiempresa: cada "Organization" (Better Auth) es una empresa/tenant.
// Toda tabla de negocio lleva organizationId y tiene RLS (ver migración rls_*).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Better Auth (usuarios, sesiones, organizaciones) ─────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  createdAt   DateTime     @default(now())
  metadata    String?
  members     Member[]
  invitations Invitation[]
  branches    Branch[]
  terminals   Terminal[]
  categories  Category[]
  products    Product[]
  customers   Customer[]
  auditLogs   AuditLog[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}

// ───────────── Negocio (con RLS por organizationId) ─────────────

/// Sucursal / local de la empresa. Las cajas (terminales) cuelgan de aquí en la Fase 1.
model Branch {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String
  name           String
  code           String
  address        String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terminals      Terminal[]

  @@unique([organizationId, code])
  @@map("branch")
}

/// Caja / terminal de venta. En la Fase 3 recibe aquí sus bloques de secuencias e-NCF.
model Terminal {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String
  branchId       String       @db.Uuid
  name           String
  code           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([branchId])
  @@map("terminal")
}

/// Mismo código que `TaxCode` de @facturacion/core (la API verifica que coincidan).
enum TaxCode {
  ITBIS18
  ITBIS16
  ITBIS0
  EXENTO
}

enum DocumentType {
  RNC
  CEDULA
  PASAPORTE
}

model Category {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String
  name           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name])
  @@map("category")
}

/// Producto o servicio vendible. Dinero en centavos (BigInt); impuesto según TaxCode.
model Product {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String
  categoryId       String?      @db.Uuid
  sku              String?
  barcode          String?
  name             String
  description      String?
  /// Precio unitario en centavos.
  price            BigInt
  /// true: `price` ya incluye el impuesto (precio al consumidor).
  priceIncludesTax Boolean      @default(true)
  tax              TaxCode      @default(ITBIS18)
  /// Unidad de medida mostrada: UND, KG, LB, HORA…
  unit             String       @default("UND")
  /// true: se vende con decimales (peso, volumen).
  allowsDecimals   Boolean      @default(false)
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, name])
  @@index([categoryId])
  @@map("product")
}

model Customer {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String
  name           String
  documentType   DocumentType?
  /// Solo dígitos (RNC 9, cédula 11) o texto libre para pasaporte.
  documentNumber String?
  email          String?
  phone          String?
  address        String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentNumber])
  @@index([organizationId, name])
  @@map("customer")
}

/// Bitácora inmutable (solo se inserta; la migración revoca UPDATE/DELETE al rol de la app).
model AuditLog {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String
  actorUserId    String?
  action         String
  entity         String
  entityId       String?
  data           Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}
