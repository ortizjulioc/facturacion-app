    "better-auth": "^1.7.10",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "prisma": "7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@facturacion/core": "workspace:*",
    "@facturacion/db": "workspace:*",
    "@types/node": "^24",
    "pino-pretty": "^13.2.0",
    "tsdown": "latest",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
