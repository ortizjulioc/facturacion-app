{
  "name": "@facturacion/pos",
  "version": "0.1.0",
  "private": true,
  "description": "Caja registradora (Electron) con SQLite local: vende sin internet y sincroniza con la nube",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "pack": "electron-vite build && electron-builder --dir --publish never",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@facturacion/core": "workspace:*",
    "@facturacion/ecf": "workspace:*",
    "@facturacion/pos-engine": "workspace:*",
    "@facturacion/printing": "workspace:*",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "Facturación"
}
