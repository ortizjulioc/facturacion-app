{
  "name": "facturacion",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:diff": "pnpm --filter @facturacion/db db:diff",
    "db:studio": "pnpm --filter @facturacion/db db:studio",
    "format": "prettier --write .",
    "db:bootstrap": "pnpm --filter @facturacion/db db:bootstrap",
    "db:deploy": "pnpm --filter @facturacion/db db:deploy",
    "merge": "git switch main && git pull origin main && git merge dev && git push origin main && git switch dev",
    "sync": "prisma generate && prisma db push",
    "pushdev": "git push origin dev"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~5.9.3"
  }
}
