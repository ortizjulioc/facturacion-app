{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate",
        "db:generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^db:generate",
        "db:generate"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build",
        "^db:generate",
        "db:generate"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^db:generate",
        "db:generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "^db:generate",
        "db:generate"
      ]
    }
  }
}
